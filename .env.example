# Copy to .env and change every secret before deploying.
ROADPULSE_SECRET=change-me-to-a-long-random-string
OFFICER_USERS=officer:change-me,supervisor:change-me-too
DEVICE_KEYS=change-me-sensor-key
# Demo area: Dwaraka Nagar, Visakhapatnam. Used by tools/fetch_map.py and the synthetic fallback grid.
# With data/area.graphml (real OpenStreetMap roads) the centre comes from the map itself.
CENTER_LAT=17.728670
CENTER_LON=83.308634
# Demo timing: seconds of normal conditions before auto-clear (use 600 in a real pilot)
CLEAR_WINDOW_S=120
# Real road network exported with tools/fetch_map.py (used automatically when the file exists)
# GRAPHML_PATH=data/area.graphml
# Real flood hotspots (surveyed lat/lon). Copy docs/hotspots.example.json to data/hotspots.json and fill it in.
# HOTSPOTS_PATH=data/hotspots.json
# Points further than this from the road network are rejected with HTTP 422
MAX_SNAP_M=250
# Set to 1 ONLY when running behind your own reverse proxy (Render, Nginx); otherwise X-Forwarded-For is ignored
TRUST_PROXY=0
DATABASE_PATH=data/roadpulse.db
LOG_LEVEL=INFO
# Telegram bot (bot/telegram_bot.py)
TELEGRAM_BOT_TOKEN=
ROADPULSE_API=http://localhost:8000
# Alert delivery (docs/ALERTS.md). The SERVER sends Telegram alerts, so TELEGRAM_BOT_TOKEN above must be set on the server too.
# Starting values, tune on real data:
# PROBE_MIN_VEHICLES=8
# PROBE_SUSTAIN_S=180
# ALERT_WARN_HORIZON_S=120
# BOARDS_PATH=data/boards.json
