# RoadPulse configuration. Copy to .env and change every "change-me". Never commit .env.
# Every value below can also be set as a plain environment variable (that is how Render and Docker do it).
# Full reference with defaults: docs/CONFIGURATION.md

# ---- Secrets and logins (required for anything other than a local try-out) --------------------------------------
# Signs login tokens. Use a long random value (48 hex characters). If empty, a random one is made per run and
# everybody has to sign in again after a restart.
ROADPULSE_SECRET=change-me-to-a-long-random-string
# Control-room accounts, "name:password" separated by commas. Names starting with "supervisor" get the supervisor role.
# No commas or colons inside a password. If empty, a random login is printed once in the server log.
OFFICER_USERS=officer:change-me,supervisor:change-me-too
# Traffic-police accounts for the /police app, same format. If empty, a random login is printed in the server log.
POLICE_USERS=unit1:change-me,unit2:change-me-too
# Keys the water sensor and the simulator send in the X-Device-Key header (comma separated). If empty, one is generated.
DEVICE_KEYS=change-me-device-key

# ---- Map and data ---------------------------------------------------------------------------------------------
# The pilot area: Dwaraka Nagar, Visakhapatnam. With data/area.graphml (real OpenStreetMap roads) the centre comes from
# the map itself. If the file is missing or cannot be loaded, the apps show a red warning and use a SYNTHETIC grid.
CENTER_LAT=17.728670
CENTER_LON=83.308634
# GRAPHML_PATH=data/area.graphml
# Surveyed flood spots (copy docs/hotspots.example.json). Without it the two demo spots are SIMULATED points on real roads.
# HOTSPOTS_PATH=data/hotspots.json
# Simulated roadside boards (copy docs/boards.example.json). Without it the busiest junctions are used.
# BOARDS_PATH=data/boards.json
# SQLite file (created on first start)
DATABASE_PATH=data/roadpulse.db

# ---- Behaviour ------------------------------------------------------------------------------------------------
# Citizen reports need a police check before the control room can publish them. Set 0 only to turn the police step off.
REQUIRE_FIELD_CONFIRMATION=1
# Seconds of normal readings before an incident clears by itself (120 for the demo, 600 for a real pilot)
CLEAR_WINDOW_S=120
# Seconds without any new evidence before an incident expires on its own
# REPORT_EXPIRY_S=3600
# Points further than this from a mapped road are rejected (HTTP 422)
MAX_SNAP_M=250

# ---- Public deployment ----------------------------------------------------------------------------------------
# Set to 1 ONLY behind your own reverse proxy (Render, Nginx): otherwise X-Forwarded-For is ignored so it cannot be faked.
TRUST_PROXY=0
# Set to 0 to hide the interactive API reference (/docs and /openapi.json) on a public server.
# API_DOCS=1
LOG_LEVEL=INFO

# ---- Optional: Telegram (the app works fully without it) ----------------------------------------------------------
# The SERVER sends Telegram alerts to subscribers who gave a chat id; bot/telegram_bot.py takes reports from Telegram.
# Not tested against a live bot in this project: try it with your own token before relying on it.
TELEGRAM_BOT_TOKEN=
ROADPULSE_API=http://localhost:8000
